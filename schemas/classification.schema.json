{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UtilityInvoiceClassification",
  "type": "object",
  "required": [
    "drive_file_id",
    "file_name",
    "processed_at",
    "status",
    "confidence",
    "rules_version"
  ],
  "properties": {
    "drive_file_id": {
      "type": "string",
      "minLength": 1
    },
    "file_name": {
      "type": "string",
      "minLength": 1
    },
    "processed_at": {
      "type": "string",
      "format": "date-time"
    },
    "document_type": {
      "enum": [
        "FATURA_AGUA",
        "FATURA_ELETRICIDADE",
        "FATURA_COMUNICACOES",
        "FATURA_OUTRA",
        "NAO_FATURA",
        null
      ]
    },
    "service": {
      "enum": [
        "AGUA",
        "ELETRICIDADE",
        "COMUNICACOES",
        "OUTRO",
        null
      ]
    },
    "provider": {
      "type": ["string", "null"]
    },
    "invoice_number": {
      "type": ["string", "null"]
    },
    "customer_number": {
      "type": ["string", "null"]
    },
    "issue_date": {
      "type": ["string", "null"],
      "format": "date"
    },
    "amount_due": {
      "type": ["number", "null"]
    },
    "currency": {
      "type": ["string", "null"]
    },
    "multibanco_entity": {
      "type": ["string", "null"]
    },
    "multibanco_reference": {
      "type": ["string", "null"]
    },
    "payment_deadline": {
      "type": ["string", "null"],
      "format": "date"
    },
    "status": {
      "enum": ["CLASSIFIED", "REVIEW", "ERROR"]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "reasoning_summary": {
      "type": ["string", "null"]
    },
    "review_reason": {
      "type": ["string", "null"]
    },
    "rules_version": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
