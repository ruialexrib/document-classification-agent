        "jsCode": "const state = $getWorkflowStaticData('global');\nif (!state.processedFileIds) state.processedFileIds = {};\n\nconst id = $json.drive_file_id;\nif (id) state.processedFileIds[id] = new Date().toISOString();\n\nconst entries = Object.entries(state.processedFileIds);\nif (entries.length > 5000) {\n  entries\n    .sort((a, b) => String(a[1]).localeCompare(String(b[1])))\n    .slice(0, entries.length - 5000)\n    .forEach(([key]) => delete state.processedFileIds[key]);\n}\n\nreturn $input.all();"
      },
