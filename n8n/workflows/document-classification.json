    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.LLM_BASE_URL + '/chat/completions' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $env.GROQ_API_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  model: $env.LLM_MODEL,\n  temperature: 0,\n  response_format: { type: 'json_object' },\n  messages: [\n    {\n      role: 'system',\n      content: 'És um agente de extração de dados de faturas em português de Portugal. Processa apenas faturas de água, eletricidade e comunicações. Devolve exclusivamente JSON válido. Nunca inventes dados. Campos: document_type (FATURA_AGUA, FATURA_ELETRICIDADE, FATURA_COMUNICACOES, FATURA_OUTRA, NAO_FATURA), service (AGUA, ELETRICIDADE, COMUNICACOES, OUTRO ou null), provider, invoice_number, customer_number, issue_date (YYYY-MM-DD ou null), amount_due (número ou null), currency (por defeito EUR apenas se explícito ou inequivocamente indicado), multibanco_entity (string ou null), multibanco_reference (string ou null), payment_deadline (YYYY-MM-DD ou null), status (CLASSIFIED, REVIEW ou ERROR), confidence (0 a 1), reasoning_summary e review_reason. Não confundas subtotal com valor a pagar. Não confundas data de emissão com data limite de pagamento. Preserva entidade e referência Multibanco como texto. Se houver ambiguidade material, usa REVIEW.'\n    },\n    {\n      role: 'user',\n      content: 'Extrai e classifica esta fatura. Nome do ficheiro: ' + ($('List input files').item.json.name || $('List input files').item.json.title || '') + '\\n\\nTEXTO DA FATURA:\\n' + (($('Extract PDF text').item.json.text || '').slice(0, 60000))\n    }\n  ]\n}) }}",
        "options": {
          "timeout": 120000
        }
      },
      "id": "groq-request",
      "name": "Classify with GroqCloud",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [
        600,
        -220
      ]
    },
    {
      "parameters": {
        "jsCode": "const raw = $json?.choices?.[0]?.message?.content ?? '';\nconst cleaned = String(raw)\n  .trim()\n  .replace(/^\\`\\`\\`json\\s*/i, '')\n  .replace(/^\\`\\`\\`\\s*/i, '')\n  .replace(/\\`\\`\\`$/i, '')\n  .trim();\n\nlet parsed;\ntry {\n  parsed = JSON.parse(cleaned);\n} catch (error) {\n  parsed = {\n    document_type: null,\n    service: null,\n    provider: null,\n    invoice_number: null,\n    customer_number: null,\n    issue_date: null,\n    amount_due: null,\n    currency: null,\n    multibanco_entity: null,\n    multibanco_reference: null,\n    payment_deadline: null,\n    status: 'ERROR',\n    confidence: 0,\n    reasoning_summary: null,\n    review_reason: 'Resposta do modelo não pôde ser convertida em JSON válido.'\n  };\n}\n\nconst allowedStatus = new Set(['CLASSIFIED', 'REVIEW', 'ERROR']);\nconst allowedService = new Set(['AGUA', 'ELETRICIDADE', 'COMUNICACOES', 'OUTRO', null]);\nconst allowedTypes = new Set(['FATURA_AGUA', 'FATURA_ELETRICIDADE', 'FATURA_COMUNICACOES', 'FATURA_OUTRA', 'NAO_FATURA', null]);\n\nlet confidence = Number(parsed.confidence);\nif (!Number.isFinite(confidence)) confidence = 0;\nconfidence = Math.max(0, Math.min(1, confidence));\n\nlet status = allowedStatus.has(parsed.status) ? parsed.status : 'REVIEW';\nconst service = allowedService.has(parsed.service ?? null) ? (parsed.service ?? null) : null;\nconst documentType = allowedTypes.has(parsed.document_type ?? null) ? (parsed.document_type ?? null) : null;\n\nif (status === 'CLASSIFIED' && confidence < 0.8) {\n  status = 'REVIEW';\n  parsed.review_reason = parsed.review_reason || 'Confiança inferior ao limiar de 0,80.';\n}\n\nconst source = $('List input files').item.json;\n\nreturn [{\n  json: {\n    drive_file_id: source.id,\n    file_name: source.name || source.title || null,\n    processed_at: new Date().toISOString(),\n    document_type: documentType,\n    service,\n    provider: parsed.provider ?? null,\n    invoice_number: parsed.invoice_number ?? null,\n    customer_number: parsed.customer_number ?? null,\n    issue_date: parsed.issue_date ?? null,\n    amount_due: parsed.amount_due === null || parsed.amount_due === undefined ? null : Number(parsed.amount_due),\n    currency: parsed.currency ?? null,\n    multibanco_entity: parsed.multibanco_entity == null ? null : String(parsed.multibanco_entity),\n    multibanco_reference: parsed.multibanco_reference == null ? null : String(parsed.multibanco_reference),\n    payment_deadline: parsed.payment_deadline ?? null,\n    status,\n    confidence,\n    reasoning_summary: parsed.reasoning_summary ?? null,\n    review_reason: parsed.review_reason ?? null,\n    rules_version: '0.2.0'\n  }\n}];"
      },
